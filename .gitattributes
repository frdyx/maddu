# Project-local POSIX CLI shim: must keep LF endings, otherwise the
# `#!/usr/bin/env bash` shebang line gets `\r` appended on Linux/macOS
# checkouts coming from a Windows clone and the kernel rejects it.
template/maddu/run text eol=lf

# Cockpit golden snapshots: written with LF by cockpit-snapshot.mjs and diffed
# byte-for-byte against the serializer's LF output. Pin to LF so a Windows
# checkout doesn't rewrite them to CRLF (the gate also normalizes on read).
scripts/test/__golden__/cockpit/*.html text eol=lf

# Published event-contract artifacts (roadmap #12b): rendered with LF by the
# event-schema module generators and byte-compared by the
# `generated-artifacts-current` gate. Pin to LF so a Windows checkout doesn't
# rewrite them to CRLF and trip the drift gate against the LF-rendering source.
docs/event-schema.md text eol=lf
docs/event-schema.json text eol=lf
template/maddu/docs/event-schema.md text eol=lf
template/maddu/docs/event-schema.json text eol=lf

# Atlas test fixture: generated with LF and content-addressed — every file's
# sha256 and byte length are recorded in the fixture's own
# inventory/atlas-index.json, and `atlas-fixture-selfcheck.mjs` recomputes both
# from the bytes on disk. Under `core.autocrlf=true` a Windows checkout would
# rewrite these to CRLF, changing every byte length and hash and failing the
# self-check on a fresh clone. Pin to LF.
scripts/test/__fixtures__/atlas/** text eol=lf
scripts/test/__fixtures__/atlas-no-index/** text eol=lf
# Same reason: atlas-vocab.mjs byte-compares this against the real corpus copy
# whenever the (gitignored) corpus is present, so a CRLF rewrite would make the
# drift tripwire fire on line endings rather than on real schema drift.
scripts/test/__fixtures__/atlas-schemas/** text eol=lf
